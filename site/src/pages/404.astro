---
import Base from '../layouts/Base.astro';

const title = 'Страница не найдена — argymaq.kg аудит';
const description =
  'Такой страницы нет. Вот разделы отчёта: аудит, план работ, что сделано и цифры результата.';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={title} description={description}>
  <section class="wrap py-20 md:py-28">
    <div class="mx-auto max-w-[640px] text-center">
      <div class="code">404</div>
      <h1 class="text-[clamp(24px,3.6vw,34px)] font-[650] leading-[1.15] tracking-[-0.028em]">
        Такой страницы нет
      </h1>
      <p class="mt-4 text-[16px] leading-relaxed" style="color: var(--color-muted);">
        Возможно, вы перешли по ссылке со старого адреса.
        Вот что точно найдётся:
      </p>

      <div class="mt-8 grid gap-2.5">
        <a href={`${base}/`} class="notfound-link">Оглавление отчёта</a>
        <a href={`${base}/audit/`} class="notfound-link">Аудит — что нашли</a>
        <a href={`${base}/plan/`} class="notfound-link">План работ</a>
        <a href={`${base}/work/`} class="notfound-link">Что сделали</a>
        <a href={`${base}/result/`} class="notfound-link">Результат — цифры</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .code {
    font-size: clamp(54px, 9vw, 92px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(100deg, #1f7cec, #7c3aed 55%, #db2777);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 18px;
  }
  .notfound-link {
    display: block;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 13px 18px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-fg);
    background: var(--color-bg);
    transition: all 0.16s ease;
  }
  .notfound-link:hover {
    border-color: var(--color-fg);
    transform: translateY(-1px);
  }
</style>