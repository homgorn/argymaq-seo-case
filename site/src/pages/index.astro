---
import Base from '../layouts/Base.astro';
import Phase from '../components/Phase.astro';
import caseData from '../data/case/argymaq.json';
import audit from '../data/case/audit.json';
import plan from '../data/case/plan.json';

const title = 'argymaq.kg — аудит сайта и план внедрения';
const description =
  'Полный аудит сайта argymaq.kg (конные туры, Каракол): 54 проблемы в 10 категориях, ' +
  'план работ из 4 приоритетов и порядок внедрения. Объект — сайт, не услуги его владельца.';

const criticalCount = audit.filter((i) => i.severity === 'critical').length;
const totalTasks = plan.reduce((n, p) => n + p.tasks.length, 0);
const measured = caseData.metrics.filter((m) => m.before !== null);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: '2026-11-15',
  about: { '@type': 'Organization', name: caseData.client, url: caseData.clientUrl },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="wrap pt-14 pb-10 md:pt-20 md:pb-14">
    <div class="hero-inner">
      <div class="sec-h">Отчёт · argymaq.kg · ноябрь 2026</div>
      <h1 class="text-[clamp(30px,5vw,46px)] font-[650] leading-[1.1] tracking-[-0.032em]">
        Аудит сайта <span class="grad">ARGYMAQ KYRGYZSTAN</span> и план внедрения
      </h1>
      <p class="mt-5 max-w-[640px] text-[clamp(15px,1.9vw,17.5px)] leading-relaxed" style="color: var(--color-muted);">
        Этот отчёт — о сайте как об инструменте: кто его находит, открывает ли он быстро,
        понятны ли ему страницы и приводит ли он клиентов. Всё, что описано здесь, относится к
        сайту и его содержанию, а не к услугам владельца бизнеса.
      </p>

      <div class="strip mt-9">
        <div class="cell">
          <div class="n tnum" style="color: var(--color-bad);">{audit.length}</div>
          <div class="l">проблем нашли</div>
        </div>
        <div class="cell">
          <div class="n tnum" style="color: var(--color-bad);">{criticalCount}</div>
          <div class="l">из них критичных</div>
        </div>
        <div class="cell">
          <div class="n tnum">{totalTasks}</div>
          <div class="l">задач в плане</div>
        </div>
        <div class="cell">
          <div class="n tnum">{caseData.pagesCount}</div>
          <div class="l">страниц на сайте</div>
        </div>
      </div>
    </div>
  </section>

  <!-- КАК ЧИТАТЬ ОТЧЁТ -->
  <section class="wrap py-10">
    <div class="box">
      <div class="box-tag">Как устроен этот отчёт</div>
      <ol class="legend">
        <li><a href="/audit/"><span class="legend-n">1</span><span><strong>Аудит</strong> — что нашли: {audit.length} проблем, с объяснением простым языком, фактом и способом исправления.</span></a></li>
        <li><a href="/plan/"><span class="legend-n">2</span><span><strong>План</strong> — в каком порядке исправляем: четыре приоритета от критичного к желаемому.</span></a></li>
        <li><a href="/work/"><span class="legend-n">3</span><span><strong>Что сделали</strong> — что уже исправлено, что в работе и что ждём от клиента.</span></a></li>
        <li><a href="/result/"><span class="legend-n">4</span><span><strong>Результат</strong> — цифры до внедрения и то, что появится после. Каждая цифра помечена источником.</span></a></li>
      </ol>
      <p class="legend-note">
        Особые пометки: <strong>[измерено]</strong> — проверено прямым запросом к сайту;
        <strong>[сообщено]</strong> — взято из внешнего источника с URL и датой;
        <strong>[выведено]</strong> — логический вывод из измерений;
        <strong>[панель]</strong> — нужны доступы, которых у нас пока нет.
      </p>
    </div>
  </section>

  <!-- БЫЛО -->
  <section class="wrap py-10">
    <div class="sec-h">С чего начали · измерено</div>
    <h2 class="text-[clamp(20px,2.6vw,27px)] font-[640] tracking-[-0.025em]">
      Что показала проверка до начала работ
    </h2>

    <div class="mt-5 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
      {measured.slice(0, 8).map((m) => (
        <div class="fact">
          <div class="fact-n tnum">{m.before}{m.beforeUnit ? ` ${m.beforeUnit}` : ''}</div>
          <div class="fact-l">{m.label}</div>
          <div class="fact-e">{m.explain}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ФАЗЫ -->
  <section class="wrap py-10">
    <div class="sec-h">Ход работ</div>
    <h2 class="text-[clamp(20px,2.6vw,27px)] font-[640] tracking-[-0.025em]">
      Четыре фазы отчёта
    </h2>

    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {caseData.phases.map((ph) => (
        <Phase
          n={ph.id}
          title={ph.name}
          text={ph.text}
          result={ph.result}
          status={ph.status === 'done' ? 'done' : ph.status === 'waiting' ? 'waiting' : 'current'}
        />
      ))}
    </div>
  </section>

  <!-- ДИСКЛЕЙМЕР -->
  <section class="wrap pb-14">
    <div class="callout">
      <strong>Что важно понимать.</strong> Этот отчёт — не предложение услуг и не продажи.
      Это измерение: что именно сейчас не так с сайтом и в каком порядке это стоит исправить.
      Внедрение, сроки и бюджет — отдельное решение, которое можно принимать на основе этого документа.
    </div>
  </section>
</Base>

<style>
  .sec-h {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-muted);
    font-weight: 650;
    margin-bottom: 12px;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .cell { background: var(--color-bg); padding: 20px 16px; }
  .cell .n {
    font-size: 26px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .cell .l { font-size: 12.5px; color: var(--color-muted); margin-top: 4px; }
  .box {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 22px 24px;
    background: var(--color-card);
  }
  .box-tag {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-muted);
    font-weight: 650;
    margin-bottom: 12px;
  }
  .legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .legend a {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 13px 15px;
    background: var(--color-bg);
    transition: all 0.16s ease;
    font-size: 14px;
    line-height: 1.5;
  }
  .legend a:hover { border-color: var(--color-fg); transform: translateY(-1px); }
  .legend-n {
    flex-shrink: 0;
    width: 24px; height: 24px;
    border-radius: 7px;
    display: grid; place-items: center;
    font-size: 12px; font-weight: 700;
    background: var(--color-fg);
    color: #fff;
  }
  .legend-note {
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .fact {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    background: var(--color-bg);
  }
  .fact-n {
    font-size: 23px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .fact-l { font-size: 13px; font-weight: 600; margin-top: 6px; }
  .fact-e {
    margin-top: 5px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .callout {
    border-left: 3px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-bg));
    padding: 16px 20px;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    font-size: 14.5px;
    line-height: 1.65;
  }
</style>