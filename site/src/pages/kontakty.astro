---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const title = 'Контакты — Digital Growth KG';
const description =
  'Свяжитесь с нами: WhatsApp +996 555 707 267, Telegram @realhikaz, refertur@yandex.ru. Бесплатный экспресс-аудит за 24 часа.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  description,
  mainEntity: {
    '@type': 'Organization',
    name: site.brand.name,
    email: site.contacts.email,
    telephone: site.contacts.whatsapp,
  },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap py-14 md:py-20">
    <div class="mx-auto max-w-[720px]">
      <div class="sec-h">Контакты</div>
      <h1 class="text-[clamp(28px,4.4vw,42px)] font-[650] leading-[1.1] tracking-[-0.03em]">
        Расскажите, что нужно — <span class="grad">посчитаем</span>
      </h1>
      <p class="mt-4 text-[16px] leading-relaxed" style="color: var(--color-muted);">
        Ответим в течение дня. Первый экспресс-аудит — бесплатно: покажем 3 главные проблемы,
        которые мешают получать заявки.
      </p>

      <div class="mt-8 grid gap-2.5 sm:grid-cols-2">
        <a href={site.contacts.whatsappLink} target="_blank" rel="noopener" class="ch">
          <span class="ch-ic" aria-hidden="true">💬</span>
          <div>
            <div class="ch-l">WhatsApp</div>
            <div class="ch-v">{site.contacts.whatsapp}</div>
          </div>
        </a>

        <a href={site.contacts.telegramLink} target="_blank" rel="noopener" class="ch">
          <span class="ch-ic" aria-hidden="true">➤</span>
          <div>
            <div class="ch-l">Telegram</div>
            <div class="ch-v">{site.contacts.telegram}</div>
          </div>
        </a>

        <a href={`mailto:${site.contacts.email}`} class="ch">
          <span class="ch-ic" aria-hidden="true">✉️</span>
          <div>
            <div class="ch-l">Почта</div>
            <div class="ch-v">{site.contacts.email}</div>
          </div>
        </a>

        <div class="ch" style="cursor: default;">
          <span class="ch-ic" aria-hidden="true">🕐</span>
          <div>
            <div class="ch-l">Режим работы</div>
            <div class="ch-v">{site.contacts.hours}</div>
          </div>
        </div>
      </div>

      <div class="band mt-9">
        <h2>Что прислать для расчёта</h2>
        <ul class="mx-auto mt-3 max-w-[420px] space-y-1.5 text-left text-[14px]"
            style="color: var(--color-muted);">
          <li>· Ссылку на сайт (если есть)</li>
          <li>· Что продаёте и в каком городе</li>
          <li>· Сколько готовы вкладывать в месяц</li>
          <li>· Есть ли уже реклама или соцсети</li>
        </ul>
        <div class="mt-5 flex flex-wrap justify-center gap-2.5">
          <a href={site.contacts.whatsappLink} target="_blank" rel="noopener" class="btn btn-primary">
            Написать в WhatsApp →
          </a>
          <a href={site.contacts.telegramLink} target="_blank" rel="noopener" class="btn">
            Telegram
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sec-h {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-muted);
    font-weight: 650;
    margin-bottom: 12px;
  }
  .ch {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 16px 18px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    background: var(--color-bg);
    transition: all 0.16s ease;
  }
  a.ch:hover {
    border-color: var(--color-ok);
    transform: translateY(-1px);
  }
  .ch-ic {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    font-size: 15px;
  }
  .ch-l {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-muted);
    font-weight: 600;
  }
  .ch-v {
    font-size: 14.5px;
    font-weight: 500;
    margin-top: 1px;
    word-break: break-word;
  }
  .band {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
    background: linear-gradient(135deg, var(--color-card), var(--color-bg));
    text-align: center;
  }
  .band h2 {
    font-size: 20px;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 640;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-fg);
    transition: all 0.16s ease;
  }
  .btn:hover { border-color: var(--color-muted); transform: translateY(-1px); }
  .btn-primary {
    background: var(--color-fg);
    color: #fff;
    border-color: var(--color-fg);
  }
  .btn-primary:hover { opacity: 0.88; }
</style>