---
import Base from '../../../layouts/Base.astro';
import Phase from '../../../components/Phase.astro';
import BeforeAfter from '../../../components/BeforeAfter.astro';
import caseData from '../../../data/case/argymaq.json';
import audit from '../../../data/case/audit.json';

const title = `${caseData.client} — кейс по продвижению`;
const description =
  `Как мы приводим в порядок сайт конных туров в Караколе: ${caseData.pagesCount} страниц, ` +
  `${audit.length} найденных проблем, 4 фазы работ.`;

const measured = caseData.metrics.filter((m) => m.after !== null);
const before = measured.map((m) => ({ label: m.label, value: `${m.before} ${m.beforeUnit}` }));
const after = measured.map((m) => ({ label: m.label, value: String(m.after) + " " + m.afterUnit }));

const criticalCount = audit.filter((i) => i.severity === 'critical').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  about: { '@type': 'Organization', name: caseData.client, url: caseData.clientUrl },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap py-14 md:py-20">
    <div class="mx-auto max-w-[880px]">
      <nav class="text-[13px] mb-5" style="color: var(--color-muted);" aria-label="Хлебные крошки">
        <a href="/" style="text-decoration:none;">Главная</a>
        <span class="mx-1.5">/</span>
        <span>Кейс</span>
        <span class="mx-1.5">/</span>
        <span>{caseData.client}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="badge-accent">{caseData.niche}</span>
        <span class="badge-muted">{caseData.region}</span>
        <span class="badge-warn">{caseData.statusLabel}</span>
      </div>

      <h1 class="text-[clamp(27px,4.2vw,40px)] font-[650] leading-[1.12] tracking-[-0.03em]">
        {caseData.client}: <span class="grad">от визитки без цен</span> до системы, которая приводит заявки
      </h1>

      <p class="mt-4 text-[17px] leading-relaxed" style="color: var(--color-muted);">
        {caseData.summary}
      </p>

      <!-- Цифры -->
      <div class="strip mt-9">
        <div class="cell">
          <div class="n tnum">{caseData.pagesCount}</div>
          <div class="l">страниц на сайте</div>
        </div>
        <div class="cell">
          <div class="n tnum" style="color: var(--color-bad);">{audit.length}</div>
          <div class="l">проблем нашли</div>
        </div>
        <div class="cell">
          <div class="n tnum" style="color: var(--color-bad);">{criticalCount}</div>
          <div class="l">из них критичных</div>
        </div>
        <div class="cell">
          <div class="n tnum">{caseData.duration}</div>
          <div class="l">фазы работ</div>
        </div>
      </div>

      <!-- Задача -->
      <div class="box mt-8">
        <div class="box-tag">Задача</div>
        <p class="box-text">{caseData.task}</p>
        <div class="mt-3 pt-3 border-t text-[13px]" style="border-color: var(--color-line); color: var(--color-muted);">
          Платформа: {caseData.stack} · Замер: {caseData.period}
        </div>
      </div>

      <!-- Фазы -->
      <h2 class="mt-12 text-[22px] font-[640] tracking-[-0.02em]">Как шли</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {caseData.phases.map((ph) => (
          <Phase
            n={ph.id}
            title={ph.name}
            text={ph.text}
            result={ph.result}
            status={ph.status === 'done' ? 'done' : ph.status === 'waiting' ? 'waiting' : 'current'}
          />
        ))}
      </div>

      <!-- Было/стало -->
      <h2 class="mt-12 text-[22px] font-[640] tracking-[-0.02em]">Что изменилось</h2>
      <p class="mt-2 mb-4 text-[14.5px]" style="color: var(--color-muted);">
        Пока измерены только значения «было» — они получены замерами до начала работ.
        Значения «стало» появятся после внедрения.
      </p>
      <BeforeAfter before={before} after={[]} beforeTitle="Было" afterTitle="Цель" />

      <!-- Навигация по кейсу -->
      <div class="mt-11 grid gap-2.5 sm:grid-cols-2">
        <a href="/kase/argymaq-kg/audit/" class="nav-card">
          <div class="nav-card-t">Что нашли</div>
          <p class="nav-card-d">Все {audit.length} проблем простыми словами</p>
        </a>
        <a href="/kase/argymaq-kg/plan/" class="nav-card">
          <div class="nav-card-t">План работ</div>
          <p class="nav-card-d">4 приоритета, сроки, стоимость</p>
        </a>
        <a href="/kase/argymaq-kg/work/" class="nav-card">
          <div class="nav-card-t">Что сделали</div>
          <p class="nav-card-d">Чек-лист внедрения</p>
        </a>
        <a href="/kase/argymaq-kg/result/" class="nav-card">
          <div class="nav-card-t">Результат</div>
          <p class="nav-card-d">Цифры и графики</p>
        </a>
      </div>

      <div class="band mt-11">
        <h2>Хотите так же для своего бизнеса?</h2>
        <p>Сделаем аудит и покажем, что мешает именно вам. Бесплатно.</p>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a href="/kontakty/" class="btn btn-primary">Оставить заявку →</a>
          <a href="/ceny/" class="btn">Цены</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .badge-accent,
  .badge-muted,
  .badge-warn {
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 99px;
    white-space: nowrap;
  }
  .badge-accent {
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    color: var(--color-accent);
  }
  .badge-muted {
    background: var(--color-card);
    color: var(--color-muted);
    border: 1px solid var(--color-line);
  }
  .badge-warn {
    background: color-mix(in srgb, var(--color-warn) 12%, transparent);
    color: var(--color-warn);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .cell { background: var(--color-bg); padding: 18px 16px; }
  .cell .n {
    font-size: 24px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .cell .l {
    font-size: 12.5px;
    color: var(--color-muted);
    margin-top: 4px;
    line-height: 1.4;
  }
  .box {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    background: var(--color-card);
  }
  .box-tag {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 650;
    margin-bottom: 7px;
    color: var(--color-muted);
  }
  .box-text { margin: 0; font-size: 14.5px; line-height: 1.55; }
  .nav-card {
    display: block;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    text-decoration: none;
    color: inherit;
    background: var(--color-bg);
    transition: all 0.16s ease;
  }
  .nav-card:hover {
    border-color: var(--color-muted);
    transform: translateY(-2px);
    box-shadow: 0 5px 18px rgba(0,0,0,.05);
  }
  .nav-card-t { font-size: 14.5px; font-weight: 600; }
  .nav-card-d {
    margin: 3px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-muted);
  }
  .band {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
    background: linear-gradient(135deg, var(--color-card), var(--color-bg));
    text-align: center;
  }
  .band h2 {
    font-size: clamp(19px, 2.6vw, 24px);
    letter-spacing: -0.022em;
    margin: 0 0 8px;
    font-weight: 640;
  }
  .band p {
    color: var(--color-muted);
    margin: 0 auto 20px;
    max-width: 420px;
    font-size: 14.5px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-fg);
    transition: all 0.16s ease;
  }
  .btn:hover { border-color: var(--color-muted); transform: translateY(-1px); }
  .btn-primary {
    background: var(--color-fg);
    color: #fff;
    border-color: var(--color-fg);
  }
  .btn-primary:hover { opacity: 0.88; }
</style>
