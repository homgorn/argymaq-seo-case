---
import Base from '../../../layouts/Base.astro';
import audit from '../../../data/case/audit.json';
import caseData from '../../../data/case/argymaq.json';

const title = 'Что нашли в argymaq.kg — аудит';
const description =
  `Полный аудит сайта конных туров в Караколе: ${audit.length} проблем, из них ` +
  `${audit.filter((i) => i.severity === 'critical').length} критичных. Каждая объяснена простыми словами.`;

const groups = [
  { key: 'critical', label: 'Критично', desc: 'Мешает получать заявки. Исправляем в первую очередь.' },
  { key: 'warning', label: 'Важно', desc: 'Заметно влияет на результат.' },
  { key: 'notice', label: 'На будущее', desc: 'Стоит сделать, но не срочно.' },
];

const counts = {
  critical: audit.filter((i) => i.severity === 'critical').length,
  warning: audit.filter((i) => i.severity === 'warning').length,
  notice: audit.filter((i) => i.severity === 'notice').length,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  about: { '@type': 'Organization', name: caseData.client, url: caseData.clientUrl },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap py-14 md:py-20">
    <div class="mx-auto max-w-[880px]">
      <nav class="text-[13px] mb-5" style="color: var(--color-muted);" aria-label="Хлебные крошки">
        <a href="/" style="text-decoration:none;">Главная</a>
        <span class="mx-1.5">/</span>
        <a href="/kase/argymaq-kg/" style="text-decoration:none;">Кейс</a>
        <span class="mx-1.5">/</span>
        <span>Аудит</span>
      </nav>

      <h1 class="text-[clamp(26px,4vw,38px)] font-[650] leading-[1.14] tracking-[-0.03em]">
        Что нашли: <span class="grad">{audit.length} проблем</span>
      </h1>
      <p class="mt-4 text-[16.5px] leading-relaxed" style="color: var(--color-muted);">
        Проверили сайт по 60 параметрам. Ниже — всё, что нашли, простыми словами:
        что это, что значит для вас и как исправляем.
      </p>

      <!-- Сводка -->
      <div class="strip mt-8">
        <div class="cell">
          <div class="n tnum" style="color: var(--color-bad);">{counts.critical}</div>
          <div class="l">критичных</div>
        </div>
        <div class="cell">
          <div class="n tnum" style="color: var(--color-warn);">{counts.warning}</div>
          <div class="l">важных</div>
        </div>
        <div class="cell">
          <div class="n tnum">{counts.notice}</div>
          <div class="l">на будущее</div>
        </div>
        <div class="cell">
          <div class="n tnum">60</div>
          <div class="l">параметров проверено</div>
        </div>
      </div>

      <!-- Группы -->
      {groups.map((g) => {
        const items = audit.filter((i) => i.severity === g.key);
        if (!items.length) return null;
        return (
          <div class="mt-12">
            <div class="flex items-baseline gap-3 mb-1">
              <h2 class="text-[21px] font-[640] tracking-[-0.02em]">{g.label}</h2>
              <span class="tnum text-[13px]" style="color: var(--color-muted);">{items.length}</span>
            </div>
            <p class="text-[14px] mb-5" style="color: var(--color-muted);">{g.desc}</p>

            <div class="grid gap-2.5">
              {items.map((item) => (
                <article class="issue reveal" data-sev={g.key}>
                  <div class="flex items-start gap-3">
                    <span class="issue-n" data-sev={g.key} aria-hidden="true">!</span>
                    <div class="min-w-0">
                      <h3 class="issue-t">{item.title}</h3>
                      <p class="issue-p">{item.plain}</p>
                      <dl class="issue-facts">
                        <dt>Факт</dt>
                        <dd>{item.fact}</dd>
                        <dt>Что делаем</dt>
                        <dd>{item.fix}</dd>
                      </dl>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        );
      })}

      <div class="mt-11 flex flex-wrap gap-2.5">
        <a href="/kase/argymaq-kg/plan/" class="btn btn-primary">Что с этим делаем →</a>
        <a href="/kase/argymaq-kg/" class="btn">К началу кейса</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .cell { background: var(--color-bg); padding: 17px 15px; }
  .cell .n {
    font-size: 23px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .cell .l {
    font-size: 12.5px;
    color: var(--color-muted);
    margin-top: 3px;
  }
  .issue {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 17px 19px;
    background: var(--color-bg);
  }
  .issue[data-sev="critical"] {
    background: color-mix(in srgb, var(--color-bad) 2%, var(--color-bg));
    border-color: color-mix(in srgb, var(--color-bad) 18%, transparent);
  }
  .issue-n {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
    margin-top: 1px;
  }
  .issue-n[data-sev="critical"] {
    background: color-mix(in srgb, var(--color-bad) 13%, transparent);
    color: var(--color-bad);
  }
  .issue-n[data-sev="warning"] {
    background: color-mix(in srgb, var(--color-warn) 14%, transparent);
    color: var(--color-warn);
  }
  .issue-n[data-sev="notice"] {
    background: var(--color-card);
    color: var(--color-muted);
    border: 1px solid var(--color-line);
  }
  .issue-t { font-size: 15px; font-weight: 600; line-height: 1.35; }
  .issue-p {
    margin: 5px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .issue-facts {
    margin: 11px 0 0;
    padding-top: 11px;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    font-size: 12.5px;
    line-height: 1.5;
  }
  .issue-facts dt {
    font-weight: 650;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 10.5px;
    padding-top: 2px;
  }
  .issue-facts dd { margin: 0; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-fg);
    transition: all 0.16s ease;
  }
  .btn:hover { border-color: var(--color-muted); transform: translateY(-1px); }
  .btn-primary {
    background: var(--color-fg);
    color: #fff;
    border-color: var(--color-fg);
  }
  .btn-primary:hover { opacity: 0.88; }
</style>