---
import Base from '../layouts/Base.astro';
import plan from '../data/case/plan.json';
import caseData from '../data/case/argymaq.json';

const title = 'План работ по argymaq.kg';
const description =
  'Четыре приоритета: что исправляем в первую неделю, что во вторую, что потом. Сроки и стоимость.';

const totalTasks = plan.reduce((n, p) => n + p.tasks.length, 0);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  about: { '@type': 'Organization', name: 'ARGYMAQ KYRGYZSTAN' },
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap py-14 md:py-20">
    <div class="mx-auto max-w-[880px]">
      <nav class="text-[13px] mb-5" style="color: var(--color-muted);" aria-label="Хлебные крошки">
        <a href={`${base}/`} style="text-decoration:none;">Главная</a>
        <span class="mx-1.5">/</span>
        <a href={`${base}/`} style="text-decoration:none;">Кейс</a>
        <span class="mx-1.5">/</span>
        <span>План</span>
      </nav>

      <h1 class="text-[clamp(26px,4vw,38px)] font-[650] leading-[1.14] tracking-[-0.03em]">
        План: <span class="grad">{totalTasks} задач</span>, четыре приоритета
      </h1>
      <p class="mt-4 text-[16.5px] leading-relaxed" style="color: var(--color-muted);">
        Не всё можно сделать сразу. Разделили работы на четыре уровня:
        от критичного к желаемому. Каждая задача — с результатом, который можно проверить.
      </p>

      {plan.map((p) => (
        <section class="mt-11">
          <div class="flex flex-wrap items-center gap-2.5 mb-2">
            <span class="lvl" data-lvl={p.level}>{p.level}</span>
            <h2 class="text-[21px] font-[640] tracking-[-0.02em]">{p.name}</h2>
            <span class="lvl-time">{p.timeframe}</span>
          </div>
          <p class="text-[15px] font-medium mb-1">{p.title}</p>
          <p class="text-[14px] leading-relaxed mb-4" style="color: var(--color-muted);">
            {p.why}
          </p>

          <div class="tasks">
            {p.tasks.map((t) => (
              <div class="task">
                <div class="task-main">
                  <span class="task-t">{t.text}</span>
                  <span class="task-who">{t.who}</span>
                </div>
                <div class="task-res">{t.result}</div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <div class="band mt-12">
        <h2>Что дальше</h2>
        <p>Следующий раздел — что уже исправлено и где виден результат.</p>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a href={`${base}/work/`} class="btn btn-primary">Что сделано →</a>
          <a href={`${base}/audit/`} class="btn">Вернуться к аудиту</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .lvl {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 99px;
    white-space: nowrap;
  }
  .lvl[data-lvl="P0"] {
    background: color-mix(in srgb, var(--color-bad) 11%, transparent);
    color: var(--color-bad);
  }
  .lvl[data-lvl="P1"] {
    background: color-mix(in srgb, var(--color-warn) 13%, transparent);
    color: var(--color-warn);
  }
  .lvl[data-lvl="P2"] {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }
  .lvl[data-lvl="P3"] {
    background: var(--color-card);
    color: var(--color-muted);
    border: 1px solid var(--color-line);
  }
  .lvl-time {
    font-size: 12.5px;
    color: var(--color-muted);
  }
  .tasks {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .task {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 13px 17px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .task:last-child { border-bottom: 0; }
  .task-main {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .task-t { font-size: 14.5px; font-weight: 500; line-height: 1.4; }
  .task-who {
    font-size: 11.5px;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .task-res {
    font-size: 12.5px;
    color: var(--color-ok);
    line-height: 1.4;
  }
  .task-res::before {
    content: '→ ';
  }
  .band {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
    background: linear-gradient(135deg, var(--color-card), var(--color-bg));
    text-align: center;
  }
  .band h2 {
    font-size: clamp(19px, 2.6vw, 24px);
    letter-spacing: -0.022em;
    margin: 0 0 8px;
    font-weight: 640;
  }
  .band p {
    color: var(--color-muted);
    margin: 0 auto 20px;
    max-width: 420px;
    font-size: 14.5px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-fg);
    transition: all 0.16s ease;
  }
  .btn:hover { border-color: var(--color-muted); transform: translateY(-1px); }
  .btn-primary {
    background: var(--color-fg);
    color: #fff;
    border-color: var(--color-fg);
  }
  .btn-primary:hover { opacity: 0.88; }
</style>