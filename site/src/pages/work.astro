---
import Base from '../layouts/Base.astro';
import audit from '../data/case/audit.json';
import plan from '../data/case/plan.json';

const title = 'Что сделали по argymaq.kg';
const description =
  'Чек-лист внедрения: что закрыто, что в работе, что ждём от клиента. С результатом по каждому пункту.';

void plan;
const unusedTasks = plan.flatMap((p) =>
  p.tasks.map((t) => ({ ...t, level: p.level, levelName: p.name })),
);

// Сопоставляем задачи плана со статусами из аудита
const doneItems = audit.filter((i) => i.status === 'done');
const pendingItems = audit.filter((i) => i.status === 'pending');

const stats = {
  done: doneItems.length,
  pending: pendingItems.length,
  total: audit.length,
};
const percent = Math.round((stats.done / stats.total) * 100);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  about: { '@type': 'Organization', name: 'ARGYMAQ KYRGYZSTAN' },
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap py-14 md:py-20">
    <div class="mx-auto max-w-[880px]">
      <nav class="text-[13px] mb-5" style="color: var(--color-muted);" aria-label="Хлебные крошки">
        <a href={`${base}/`} style="text-decoration:none;">Главная</a>
        <span class="mx-1.5">/</span>
        <a href={`${base}/`} style="text-decoration:none;">Кейс</a>
        <span class="mx-1.5">/</span>
        <span>Внедрение</span>
      </nav>

      <h1 class="text-[clamp(26px,4vw,38px)] font-[650] leading-[1.14] tracking-[-0.03em]">
        Что сделали: <span class="grad">{stats.done} из {stats.total}</span>
      </h1>
      <p class="mt-4 text-[16.5px] leading-relaxed" style="color: var(--color-muted);">
        Каждый пункт — с результатом, который можно проверить. Если что-то не сделано —
        видно, что именно и почему.
      </p>

      <!-- Прогресс -->
      <div class="mt-8 box">
        <div class="flex items-baseline justify-between mb-2">
          <span class="text-[13.5px] font-medium">Прогресс внедрения</span>
          <span class="tnum text-[13.5px] font-semibold">{percent}%</span>
        </div>
        <div class="bar" role="img" aria-label={`Выполнено ${percent}%`}>
          <div class="bar-fill" style={`width: ${percent}%`}></div>
        </div>
        <div class="mt-2 flex gap-4 text-[12.5px]" style="color: var(--color-muted);">
          <span>Готово: <strong style="color: var(--color-ok);">{stats.done}</strong></span>
          <span>В работе: <strong style="color: var(--color-warn);">{stats.pending}</strong></span>
        </div>
      </div>

      <!-- Сделано -->
      <h2 class="mt-11 text-[21px] font-[640] tracking-[-0.02em]">
        Сделано <span class="tnum text-[13px] font-normal" style="color: var(--color-muted);">({doneItems.length})</span>
      </h2>
      <div class="mt-4 grid gap-2.5">
        {doneItems.map((item) => (
          <div class="work reveal" data-done="true">
            <div class="flex items-start gap-3">
              <span class="tick" aria-hidden="true">✓</span>
              <div class="min-w-0">
                <h3 class="work-t">{item.title}</h3>
                <p class="work-p">{item.plain}</p>
                <p class="work-r">{item.fix}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- В работе -->
      <h2 class="mt-11 text-[21px] font-[640] tracking-[-0.02em]">
        В работе <span class="tnum text-[13px] font-normal" style="color: var(--color-muted);">({pendingItems.length})</span>
      </h2>
      <div class="mt-4 grid gap-2.5">
        {pendingItems.map((item) => (
          <div class="work reveal" data-done="false">
            <div class="flex items-start gap-3">
              <span class="tick tick-wait" aria-hidden="true">·</span>
              <div class="min-w-0">
                <h3 class="work-t">{item.title}</h3>
                <p class="work-p">{item.plain}</p>
                <p class="work-r work-r-wait">Планируем: {item.fix}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="band mt-11">
        <h2>Что дальше</h2>
        <p>Следующий раздел — цифры «до» и то, что появится после внедрения.</p>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a href={`${base}/result/`} class="btn btn-primary">Смотреть результат →</a>
          <a href={`${base}/plan/`} class="btn">Вернуться к плану</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .box {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 17px 19px;
    background: var(--color-card);
  }
  .bar {
    height: 8px;
    border-radius: 99px;
    background: var(--color-line);
    overflow: hidden;
    margin-top: 4px;
  }
  .bar-fill {
    height: 100%;
    border-radius: 99px;
    background: var(--color-ok);
    transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 15px 18px;
    background: var(--color-bg);
  }
  .work[data-done="true"] {
    background: color-mix(in srgb, var(--color-ok) 2.5%, var(--color-bg));
    border-color: color-mix(in srgb, var(--color-ok) 20%, transparent);
  }
  .tick {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    margin-top: 2px;
    background: var(--color-ok);
    color: #fff;
  }
  .tick-wait {
    background: color-mix(in srgb, var(--color-warn) 15%, transparent);
    color: var(--color-warn);
    font-size: 15px;
    line-height: 1;
  }
  .work-t { font-size: 14.5px; font-weight: 600; line-height: 1.35; }
  .work-p {
    margin: 4px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .work-r {
    margin: 8px 0 0;
    font-size: 12.5px;
    color: var(--color-ok);
    line-height: 1.4;
  }
  .work-r::before { content: '→ '; }
  .work-r-wait { color: var(--color-muted); }
  .band {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
    background: linear-gradient(135deg, var(--color-card), var(--color-bg));
    text-align: center;
  }
  .band h2 {
    font-size: clamp(19px, 2.6vw, 24px);
    letter-spacing: -0.022em;
    margin: 0 0 8px;
    font-weight: 640;
  }
  .band p {
    color: var(--color-muted);
    margin: 0 auto 20px;
    max-width: 420px;
    font-size: 14.5px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-fg);
    transition: all 0.16s ease;
  }
  .btn:hover { border-color: var(--color-muted); transform: translateY(-1px); }
  .btn-primary {
    background: var(--color-fg);
    color: #fff;
    border-color: var(--color-fg);
  }
  .btn-primary:hover { opacity: 0.88; }
</style>