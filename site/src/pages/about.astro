---
import Base from '../layouts/Base.astro';
import services from '../data/services.json';
import process from '../data/process.json';
import packages from '../data/packages.json';
import caseData from '../data/case/argymaq.json';
import site from '../data/site.json';

const title = 'О нас — Digital Growth KG';
const description =
  'Помогаем бизнесу в Кыргызстане получать клиентов из поиска, соцсетей и нейросетей. ' +
  'Показываем результат цифрами, а не отчётами «мы поработали».';

const stats = [
  { n: '60', l: 'параметров проверяем на аудите' },
  { n: String(packages.length), l: 'пакета на выбор' },
  { n: String(services.length), l: 'направлений работы' },
  { n: '24 ч', l: 'на первый экспресс-аудит' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
  mainEntity: {
    '@type': 'Organization',
    name: site.brand.name,
    url: site.brand.url,
    email: site.contacts.email,
    telephone: site.contacts.whatsapp,
  },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap py-14 md:py-20">
    <div class="mx-auto max-w-[820px]">
      <div class="sec-h">О нас</div>
      <h1 class="text-[clamp(28px,4.4vw,42px)] font-[650] leading-[1.1] tracking-[-0.03em]">
        Показываем <span class="grad">результат цифрами</span>
      </h1>
      <p class="mt-4 text-[17px] leading-relaxed" style="color: var(--color-muted);">
        Мы не обещаем «топ-1 за месяц». Мы проверяем, объясняем и делаем.
        Каждый отчёт — с числами, которые можно проверить.
      </p>

      <div class="strip mt-9">
        {stats.map((s) => (
          <div class="cell">
            <div class="n tnum">{s.n}</div>
            <div class="l">{s.l}</div>
          </div>
        ))}
      </div>

      <!-- Принципы -->
      <h2 class="mt-12 text-[22px] font-[640] tracking-[-0.02em]">Во что верим</h2>
      <div class="mt-4 grid gap-2.5">
        {[
          {
            t: 'Не выдумываем цифры',
            d: 'Если чего-то не измерили — так и пишем. Придуманный результат хуже честного пробела.',
          },
          {
            t: 'Говорим на вашем языке',
            d: 'Не «LCP вне зелёной зоны», а «сайт открывается 4 секунды — люди уходят».',
          },
          {
            t: 'Не обещаем невозможного',
            d: 'Позиции в поиске не покупаются. Мы можем влиять на процесс, а не гарантировать место.',
          },
          {
            t: 'Показываем и провалы',
            d: 'Если что-то не сработало — пишем об этом и объясняем почему.',
          },
          {
            t: 'Фиксированные цены',
            d: 'Никаких «звоните — договоримся». Пакеты видны сразу, в сомах.',
          },
        ].map((p) => (
          <div class="box reveal">
            <div class="box-t">{p.t}</div>
            <p class="box-d">{p.d}</p>
          </div>
        ))}
      </div>

      <!-- Как работаем -->
      <h2 class="mt-12 text-[22px] font-[640] tracking-[-0.02em]">Как устроена работа</h2>
      <p class="mt-2 mb-5 text-[14.5px] leading-relaxed" style="color: var(--color-muted);">
        {process.length} шагов от первого письма до отчёта. Подробнее — на странице
        <a href="/kak-rabotaem/" class="underline" style="color: var(--color-accent);">«Как мы работаем»</a>.
      </p>

      <div class="grid gap-2.5 sm:grid-cols-2">
        {process.map((p) => (
          <div class="step">
            <div class="step-n">{p.n}</div>
            <div class="step-t">{p.title}</div>
            <div class="step-d">{p.text}</div>
          </div>
        ))}
      </div>

      <!-- Кейс -->
      <h2 class="mt-12 text-[22px] font-[640] tracking-[-0.02em]">Наш первый кейс</h2>
      <div class="case-link mt-4">
        <div class="flex-1">
          <div class="cl-t">{caseData.client}</div>
          <p class="cl-d">
            {caseData.niche} · {caseData.region} · {caseData.pagesCount} страниц
          </p>
        </div>
        <a href="/kase/argymaq-kg/" class="btn btn-primary">Смотреть →</a>
      </div>

      <!-- Контакты -->
      <div class="band mt-12">
        <h2>Давайте знакомиться</h2>
        <p>Первый экспресс-аудит — бесплатно. Покажем 3 проблемы, которые мешают заявкам.</p>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a href={site.contacts.whatsappLink} target="_blank" rel="noopener" class="btn btn-primary">
            WhatsApp →
          </a>
          <a href="/kontakty/" class="btn">Все контакты</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sec-h {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-muted);
    font-weight: 650;
    margin-bottom: 12px;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .cell { background: var(--color-bg); padding: 19px 16px; }
  .cell .n {
    font-size: 25px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .cell .l {
    font-size: 12.5px;
    color: var(--color-muted);
    margin-top: 4px;
    line-height: 1.4;
  }
  .box {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 17px 19px;
    background: var(--color-bg);
  }
  .box-t { font-size: 15px; font-weight: 600; }
  .box-d {
    margin: 5px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .step {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    background: var(--color-bg);
  }
  .step-n {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    margin-bottom: 9px;
  }
  .step-t { font-size: 14.5px; font-weight: 600; }
  .step-d {
    margin: 3px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .case-link {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 20px 22px;
    background: var(--color-card);
  }
  .cl-t { font-size: 16px; font-weight: 600; }
  .cl-d {
    margin: 3px 0 0;
    font-size: 13px;
    color: var(--color-muted);
  }
  .band {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
    background: linear-gradient(135deg, var(--color-card), var(--color-bg));
    text-align: center;
  }
  .band h2 {
    font-size: clamp(19px, 2.6vw, 24px);
    letter-spacing: -0.022em;
    margin: 0 0 8px;
    font-weight: 640;
  }
  .band p {
    color: var(--color-muted);
    margin: 0 auto 20px;
    max-width: 440px;
    font-size: 14.5px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-fg);
    transition: all 0.16s ease;
  }
  .btn:hover { border-color: var(--color-muted); transform: translateY(-1px); }
  .btn-primary {
    background: var(--color-fg);
    color: #fff;
    border-color: var(--color-fg);
  }
  .btn-primary:hover { opacity: 0.88; }
</style>