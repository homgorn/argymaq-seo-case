---
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import process from '../data/process.json';

const title = 'Как мы работаем — Refertur.net';
const description =
  'Пять шагов работы: бриф, аудит, план, внедрение и отчёт. Вы всегда знаете, на каком этапе проект, ' +
  'что от вас нужно и что будет дальше. Без воды и скрытых доплат.';

const steps = [
  ...process.map((p) => ({
    title: `${p.n}. ${p.title}`,
    markdown: `${p.text} **Клиент:** ${p.client.toLowerCase()}. **Мы:** ${p.us.toLowerCase()}.`,
    status: 'current' as const,
  })),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Как мы работаем',
  description,
  step: process.map((p, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: p.title,
    text: p.text,
  })),
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap py-14 md:py-20">
    <div class="mx-auto max-w-[760px]">
      <div class="sec-h">Процесс</div>
      <h1 class="text-[clamp(28px,4.4vw,42px)] font-[650] leading-[1.1] tracking-[-0.03em]">
        Пять шагов, <span class="grad">без сюрпризов</span>
      </h1>
      <p class="mt-4 text-[16px] leading-relaxed" style="color: var(--color-muted);">
        Вы всегда знаете, на каком этапе проект, что от вас нужно и что будет дальше.
        Никаких «мы работаем» без объяснений.
      </p>

      <div class="mt-10">
        <Steps items={steps} direction="column" />
      </div>

      <div class="band mt-6">
        <h2>Что важно понимать</h2>
        <div class="mx-auto mt-4 max-w-[560px] space-y-3 text-left text-[14px] leading-relaxed"
             style="color: var(--color-muted);">
          <p>
            <strong style="color: var(--color-fg);">Сроки не обещаем с потолка.</strong>
            Первые технические улучшения видны сразу. Первые позиции в поиске — через 2–3 месяца.
            Это не наша придумка: столько нужно поисковикам, чтобы заметить изменения.
          </p>
          <p>
            <strong style="color: var(--color-fg);">Каждый пункт — с результатом.</strong>
            Не «оптимизировали страницу», а «было 150 МБ, стало 4 МБ».
          </p>
          <p>
            <strong style="color: var(--color-fg);">Если что-то не получилось — скажем.</strong>
            Отчёт показывает и успехи, и провалы. Иначе ему нельзя верить.
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-2.5">
        <a href="/kase/argymaq-kg/" class="btn btn-primary">Смотреть кейс →</a>
        <a href="/kontakty/" class="btn">Обсудить проект</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .sec-h {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-muted);
    font-weight: 650;
    margin-bottom: 12px;
  }
  .band {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 30px 28px;
    background: linear-gradient(135deg, var(--color-card), var(--color-bg));
    margin-top: 8px;
  }
  .band h2 {
    font-size: 19px;
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 640;
    text-align: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 20px;
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-fg);
    transition: all 0.16s ease;
  }
  .btn:hover { border-color: var(--color-muted); transform: translateY(-1px); }
  .btn-primary {
    background: var(--color-fg);
    color: #fff;
    border-color: var(--color-fg);
  }
  .btn-primary:hover { opacity: 0.88; }
</style>