---
import site from '../data/case/argymaq.json';

const nav = [
  { label: 'Аудит', href: '/audit/' },
  { label: 'План', href: '/plan/' },
  { label: 'Что сделали', href: '/work/' },
  { label: 'Результат', href: '/result/' },
];
---

<footer class="mt-5 border-t" style="border-color: var(--color-line);">
  <div class="wrap py-8 pb-10">
    <div class="flex flex-col gap-5 sm:flex-row sm:justify-between sm:gap-8">
      <div class="max-w-[340px]">
        <p class="text-[13px] font-semibold" style="color: var(--color-fg);">ARGYMAQ KYRGYZSTAN</p>
        <p class="mt-1.5 text-[12.5px] leading-relaxed" style="color: var(--color-muted);">
          Отчёт об аудите сайта argymaq.kg и план внедрения.
          Объект оценки — сам сайт, не услуги его владельца.
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-[12.5px]" style="color: var(--color-muted);">
        {nav.map((item) => (
          <a href={item.href} class="hover:text-[var(--color-fg)]" style="text-decoration:none;">{item.label}</a>
        ))}
      </nav>

      <div class="text-[12px]" style="color: var(--color-muted);">
        <p style="margin:0;">Замер: 14–15 ноября 2026</p>
        <p style="margin:2px 0 0;">Регион: Каракол, Кыргызстан</p>
      </div>
    </div>

    <div
      class="mt-6 flex flex-col gap-1.5 border-t pt-5 text-[11.5px] sm:flex-row sm:justify-between"
      style="border-color: var(--color-line); color: var(--color-muted);"
    >
      <p style="margin:0;">Данные отчёта воспроизводимы скриптами из репозитория — см. исходники аудита.</p>
      <p style="margin:0;">[измерено] — прямое измерение · [выведено] — вывод · [панель] — нужны доступы</p>
    </div>
  </div>
</footer>