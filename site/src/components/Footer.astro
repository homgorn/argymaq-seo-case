---
import site from '../data/site.json';

const year = new Date().getFullYear();
const nav = site.nav;
---

<footer class="mt-5 border-t" style="border-color: var(--color-line);">
  <div class="wrap py-10 pb-12">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">

      <div class="max-w-[260px]">
        <div class="flex items-center gap-2 font-semibold" style="color: var(--color-fg);">
          <span
            class="grid h-[22px] w-[22px] place-items-center rounded-md text-[11px] font-bold text-white"
            style="background: var(--color-fg);"
          >{site.brand.nameShort}</span>
          {site.brand.name}
        </div>
        <p class="mt-2 text-[13.5px] leading-relaxed" style="color: var(--color-muted);">
          {site.brand.tagline}
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-[13.5px]" style="color: var(--color-muted);">
        {nav.map((item) => (
          <a href={item.href} class="hover:text-[var(--color-fg)]" style="text-decoration:none;">
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex flex-col gap-2 text-[13.5px]">
        <a
          href={site.contacts.whatsappLink}
          target="_blank"
          rel="noopener"
          class="contact-chip"
        >
          <span aria-hidden="true">💬</span> {site.contacts.whatsapp}
        </a>
        <a href={`mailto:${site.contacts.email}`} class="contact-chip">
          <span aria-hidden="true">✉️</span> {site.contacts.email}
        </a>
        <a
          href={site.contacts.telegramLink}
          target="_blank"
          rel="noopener"
          class="contact-chip"
        >
          <span aria-hidden="true">➤</span> {site.contacts.telegram}
        </a>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-2 border-t pt-6 text-[12.5px] md:flex-row md:justify-between"
      style="border-color: var(--color-line); color: var(--color-muted);"
    >
      <p>© {year} {site.brand.name}. {site.contacts.address}</p>
      <p>{site.contacts.hours}</p>
    </div>
  </div>
</footer>

<style>
  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    color: var(--color-fg);
    text-decoration: none;
    transition: all 0.16s ease;
    font-size: 13.5px;
    width: fit-content;
  }
  .contact-chip:hover {
    border-color: var(--color-ok);
    color: var(--color-ok);
    transform: translateY(-1px);
  }
</style>