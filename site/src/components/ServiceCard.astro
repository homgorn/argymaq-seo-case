---
interface Props {
  icon?: string;
  title: string;
  lead?: string;
  problem?: string;
  outcome?: string;
  priceFrom?: number;
  priceUnit?: string;
  href?: string;
}

const {
  icon,
  title,
  lead,
  problem,
  outcome,
  priceFrom,
  priceUnit,
  href = '/uslugi/',
} = Astro.props;

const fmt = priceFrom ? new Intl.NumberFormat('ru-RU').format(priceFrom) : null;
---

<a
  href={href}
  class="reveal group block rounded-[var(--radius-xl)] border p-[22px] transition-all"
>
  {icon && (
    <div class="mb-3.5 grid h-9 w-9 place-items-center rounded-[9px] border text-[15px]"
         style="background: var(--color-card); border-color: var(--color-line);"
         aria-hidden="true">
      {icon}
    </div>
  )}

  <h3 class="text-[16px] font-semibold tracking-tight">{title}</h3>

  {lead && (
    <p class="mt-1.5 text-[14px] leading-relaxed" style="color: var(--color-muted);">
      {lead}
    </p>
  )}

  {outcome && (
    <p class="mt-3 text-[13px] leading-relaxed flex gap-2">
      <span style="color: var(--color-ok); font-weight:700;" aria-hidden="true">→</span>
      <span>{outcome}</span>
    </p>
  )}

  {fmt && (
    <div class="mt-4 text-[13px] font-semibold" style="color: var(--color-accent);">
      от {fmt} {priceUnit}
    </div>
  )}
</a>

<style>
  a {
    text-decoration: none;
    color: inherit;
    border-color: var(--color-line);
    background: var(--color-bg);
  }
  a:hover {
    border-color: var(--color-muted);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,.05);
  }
</style>