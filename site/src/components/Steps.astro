---
interface Props {
  items: { title: string; markdown?: string; status?: 'done' | 'current' | 'todo' | 'blocked' }[];
  direction?: 'column' | 'row';
}

const { items, direction = 'column' } = Astro.props;
const isRow = direction === 'row';
---

<ol
  class:list={[
    'flex list-none p-0 m-0 gap-0',
    isRow ? 'flex-col sm:flex-row' : 'flex-col',
  ]}
>
  {items.map((item, i) => (
    <li class="flex-1 flex gap-3 min-w-0">
      <div class="flex flex-col items-center" aria-hidden="true">
        <span class="node" class:list={[item.status ?? '']}>
          {item.status === 'done' ? '✓' : i + 1}
        </span>
        {i < items.length - 1 && <span class="line" class:list={[item.status ?? '']}></span>}
      </div>
      <div class="pb-6 min-w-0">
        <div class="text-[14.5px] font-medium leading-snug">{item.title}</div>
        {item.markdown && (
          <p class="mt-1 text-[13px] leading-relaxed" style="color: var(--color-muted);">
            {item.markdown}
          </p>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .node {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
    border: 1.5px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-muted);
  }
  .node.done {
    border-color: var(--color-ok);
    background: var(--color-ok);
    color: #fff;
  }
  .node.current {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
  .node.blocked {
    border-color: var(--color-bad);
    color: var(--color-bad);
  }

  .line {
    width: 2px;
    flex: 1;
    min-height: 14px;
    background: var(--color-line);
  }
  .line.done { background: var(--color-ok); }
  .line.current { background: var(--color-accent); }
</style>