---
interface Feature {
  text: string;
  included: boolean;
}
interface Props {
  name: string;
  price: number;
  period?: string;
  tagline?: string;
  forWhom?: string;
  highlight?: boolean;
  highlightLabel?: string;
  features: Feature[];
  note?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  name,
  price,
  period = 'мес',
  tagline,
  forWhom,
  highlight = false,
  highlightLabel = 'чаще всего выбирают',
  features,
  note,
  ctaHref = '/kontakty/',
  ctaLabel = 'Выбрать',
} = Astro.props;

const fmt = new Intl.NumberFormat('ru-RU').format(price);
---

<div
  class="reveal relative flex flex-col rounded-[var(--radius-xl)] border p-6"
  class:list={[{ hot: highlight }]}
>
  {highlight && <div class="flag">{highlightLabel}</div>}

  <div class="text-[14px] font-semibold" style="color: var(--color-muted);">{name}</div>

  {tagline && (
    <p class="mt-1 text-[13px] leading-snug" style="color: var(--color-muted);">{tagline}</p>
  )}

  <div class="mt-3 flex items-baseline gap-1.5">
    <span class="tnum text-[32px] font-bold leading-none tracking-tight">{fmt}</span>
    <span class="text-[13px] font-medium" style="color: var(--color-muted);">сом/{period}</span>
  </div>

  {forWhom && (
    <p class="mt-3 text-[12.5px] leading-relaxed" style="color: var(--color-muted);">{forWhom}</p>
  )}

  <a href={ctaHref} class="mt-5 btn-block" class:list={[{ primary: highlight }]}>
    {ctaLabel} →
  </a>

  <ul class="mt-5 space-y-[7px] text-[13.5px] list-none p-0 m-0">
    {features.map((f) => (
      <li class:list={['flex gap-2.5 leading-snug', !f.included && 'excluded']}>
        <span class="tick" aria-hidden="true">{f.included ? '✓' : '·'}</span>
        <span>{f.text}</span>
      </li>
    ))}
  </ul>

  {note && (
    <p class="mt-5 pt-4 border-t text-[12px] leading-relaxed"
       style="border-color: var(--color-line); color: var(--color-muted);">
      {note}
    </p>
  )}
</div>

<style>
  .hot {
    border-color: var(--color-fg);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.07);
  }
  .flag {
    position: absolute;
    top: -11px;
    left: 22px;
    background: var(--color-fg);
    color: #fff;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 99px;
    white-space: nowrap;
  }
  .btn-block {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: var(--radius-lg);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-fg);
    transition: all 0.16s ease;
  }
  .btn-block:hover {
    border-color: var(--color-muted);
    transform: translateY(-1px);
  }
  .btn-block.primary {
    background: var(--color-fg);
    color: #fff;
    border-color: var(--color-fg);
  }
  .btn-block.primary:hover { opacity: 0.88; }

  .tick {
    flex-shrink: 0;
    color: var(--color-ok);
    font-weight: 700;
    line-height: 1.5;
  }
  .excluded { opacity: 0.45; }
  .excluded .tick { color: var(--color-line); }
</style>