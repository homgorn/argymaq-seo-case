# Normalise line endings so scripts and templates behave the same everywhere.
* text=auto eol=lf

# Explicit text types
*.md      text eol=lf
*.py      text eol=lf
*.astro   text eol=lf
*.json    text eol=lf
*.mjs     text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.txt     text eol=lf
*.svg     text eol=lf

# Windows scripts keep CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.db      binary
*.woff    binary
*.woff2   binary